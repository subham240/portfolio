---
import { projects } from '../data/portfolio';
---

<section id="projects" class="ui-section bg-[#faf7f2] relative z-[1]">
  <div class="ui-container">
    <!-- Header -->
    <div class="mb-16 grid grid-cols-1 gap-6 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <p class="section-label mb-3" data-reveal>Featured Work</p>
        <h2 class="section-heading" data-reveal data-delay="1">
          Selected Projects
        </h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-brand-dark/70 md:text-right" data-reveal data-delay="2">
        Real-world machine learning implementations — from exploratory analysis and model building to live, user-facing tools.
      </p>
    </div>

    <!-- Projects list -->
    <div class="flex flex-col gap-16 lg:gap-24">

      <!-- Project 01: Medical Lab Report Assistant -->
      <article
        class="project-card group rounded-2xl md:rounded-3xl border border-brand-dark/10 bg-surface p-6 sm:p-8 lg:p-12 transition-all duration-500 hover:border-brand-accent/40 hover:shadow-xl"
        data-reveal data-delay="1"
      >
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-12">
          <!-- Text details -->
          <div class="flex flex-col gap-5 order-2 lg:order-1">
            <div class="flex items-center gap-3">
              <span class="font-heading text-2xl font-bold text-brand-accent">01.</span>
              <p class="section-label text-brand-dark/60">AI-Powered Health Tool</p>
            </div>

            <h3 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-bold leading-tight text-brand-dark group-hover:text-brand-accent transition-colors">
              Medical Lab Report Assistant
            </h3>

            <p class="text-sm sm:text-base leading-relaxed text-brand-dark/75">
              Built a Streamlit application that lets users upload medical lab reports and automatically extracts key health parameters, flagging values outside normal reference ranges. Combined document parsing with a data-driven interpretation layer to present results in plain, easy-to-understand language for non-technical users.
            </p>

            <!-- Tech tags -->
            <div class="flex flex-wrap gap-2 pt-1" aria-label="Technologies">
              {['Python', 'Streamlit', 'Document Parsing', 'AI-Assisted Interpretation'].map((tech) => (
                <span class="tech-tag">{tech}</span>
              ))}
            </div>

            <!-- Actions -->
            <div class="flex flex-wrap items-center gap-3 pt-3 border-t border-brand-dark/10">
              <a
                href="https://medical-lab-report-assistant-3jtf93nk6a9nszarn4mdnj.streamlit.app/"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary group/btn text-xs h-10 px-6 inline-flex items-center gap-2"
              >
                <span>Live Demo</span>
                <span aria-hidden="true" class="transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5">&nearr;</span>
              </a>
              <a
                href="https://github.com/subham240/medical-lab-report-assistant"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-outline group/btn text-xs h-10 px-6 inline-flex items-center gap-2"
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                <span>GitHub Source</span>
                <span aria-hidden="true" class="transition-transform duration-300 group-hover/btn:translate-x-1">&rarr;</span>
              </a>
            </div>
          </div>

          <!-- UI Showcase Mockup -->
          <a
            href="https://medical-lab-report-assistant-3jtf93nk6a9nszarn4mdnj.streamlit.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="order-1 lg:order-2 block overflow-hidden rounded-xl border border-brand-dark/15 bg-[#1a1a18] p-5 text-brand-light shadow-lg transition-transform duration-700 ease-out group-hover:scale-[1.02]"
            data-cursor-target
            data-cursor-label="Live Demo ↗"
          >
            <div class="flex items-center justify-between border-b border-brand-light/10 pb-3">
              <div class="flex items-center gap-2">
                <span class="h-2.5 w-2.5 rounded-full bg-red-400/80"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-amber-400/80"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-emerald-400/80"></span>
                <span class="ml-2 font-mono text-[0.7rem] text-brand-light/60">streamlit / lab_report_app.py</span>
              </div>
              <span class="rounded bg-emerald-500/20 px-2 py-0.5 text-[0.65rem] font-medium text-emerald-300">RAG Pipeline Active</span>
            </div>

            <!-- Parameters Preview Cards -->
            <div class="mt-4 flex flex-col gap-2.5">
              <div class="flex items-center justify-between rounded-lg bg-brand-light/5 p-2.5 transition-colors hover:bg-brand-light/10">
                <div>
                  <p class="text-xs font-semibold text-brand-light">Hemoglobin</p>
                  <p class="text-[0.65rem] text-brand-light/50">Ref: 13.5 – 17.5 g/dL</p>
                </div>
                <div class="text-right">
                  <span class="font-mono text-xs font-bold text-emerald-400">14.2 g/dL</span>
                  <span class="block text-[0.6rem] text-emerald-400/80">Normal</span>
                </div>
              </div>

              <div class="flex items-center justify-between rounded-lg bg-amber-500/10 border border-amber-500/20 p-2.5 transition-colors hover:bg-amber-500/20">
                <div>
                  <p class="text-xs font-semibold text-amber-200">Fasting Blood Glucose</p>
                  <p class="text-[0.65rem] text-brand-light/50">Ref: 70 – 99 mg/dL</p>
                </div>
                <div class="text-right">
                  <span class="font-mono text-xs font-bold text-amber-400">142 mg/dL &uarr;</span>
                  <span class="block text-[0.6rem] text-amber-300 font-semibold">Flagged: High</span>
                </div>
              </div>

              <div class="flex items-center justify-between rounded-lg bg-brand-light/5 p-2.5 transition-colors hover:bg-brand-light/10">
                <div>
                  <p class="text-xs font-semibold text-brand-light">Serum Creatinine</p>
                  <p class="text-[0.65rem] text-brand-light/50">Ref: 0.7 – 1.3 mg/dL</p>
                </div>
                <div class="text-right">
                  <span class="font-mono text-xs font-bold text-emerald-400">0.95 mg/dL</span>
                  <span class="block text-[0.6rem] text-emerald-400/80">Normal</span>
                </div>
              </div>
            </div>

            <div class="mt-3 rounded-lg border border-brand-light/10 bg-brand-light/5 p-3 text-[0.7rem] text-brand-light/70 leading-relaxed">
              <span class="font-semibold text-brand-accent">Plain-Language Summary:</span> Fasting glucose exceeds reference threshold. Grounded medical explanations retrieved from indexed reference guides.
            </div>
          </a>
        </div>
      </article>

      <!-- Project 02: SnapClass -->
      <article
        class="project-card group rounded-2xl md:rounded-3xl border border-brand-dark/10 bg-surface p-6 sm:p-8 lg:p-12 transition-all duration-500 hover:border-brand-accent/40 hover:shadow-xl"
        data-reveal data-delay="2"
      >
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-12">
          <!-- UI Showcase Mockup -->
          <a
            href="https://snapclass-landing-hazel.vercel.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="block overflow-hidden rounded-xl border border-brand-dark/15 bg-[#1a1a18] p-5 text-brand-light shadow-lg transition-transform duration-700 ease-out group-hover:scale-[1.02]"
            data-cursor-target
            data-cursor-label="Live Demo ↗"
          >
            <div class="flex items-center justify-between border-b border-brand-light/10 pb-3">
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="font-mono text-[0.7rem] text-brand-light/60">SnapClass Vision & Voice Biometrics</span>
              </div>
              <span class="rounded bg-brand-accent/20 px-2 py-0.5 text-[0.65rem] font-medium text-brand-accent">Dual-Modal AI</span>
            </div>

            <!-- Vision detection mock -->
            <div class="mt-4 relative rounded-lg border border-brand-light/10 bg-brand-light/5 p-4">
              <div class="grid grid-cols-3 gap-3">
                <div class="flex flex-col items-center gap-1 rounded border border-emerald-500/50 bg-emerald-500/10 p-2 text-center">
                  <span class="text-[0.65rem] font-bold text-emerald-300">Face Match</span>
                  <span class="font-mono text-[0.6rem] text-brand-light/70">ID #2401</span>
                  <span class="text-[0.55rem] text-emerald-400 font-semibold">&check; 98.4%</span>
                </div>
                <div class="flex flex-col items-center gap-1 rounded border border-emerald-500/50 bg-emerald-500/10 p-2 text-center">
                  <span class="text-[0.65rem] font-bold text-emerald-300">Face Match</span>
                  <span class="font-mono text-[0.6rem] text-brand-light/70">ID #2402</span>
                  <span class="text-[0.55rem] text-emerald-400 font-semibold">&check; 96.1%</span>
                </div>
                <div class="flex flex-col items-center gap-1 rounded border border-brand-light/20 bg-brand-light/5 p-2 text-center">
                  <span class="text-[0.65rem] font-bold text-brand-light/60">Enrolled</span>
                  <span class="font-mono text-[0.6rem] text-brand-light/50">ID #2403</span>
                  <span class="text-[0.55rem] text-brand-light/40">Queue</span>
                </div>
              </div>

              <!-- Voice biometrics waveform indicator -->
              <div class="mt-4 border-t border-brand-light/10 pt-3">
                <div class="flex items-center justify-between text-[0.65rem] text-brand-light/60 mb-1.5">
                  <span>Voice Biometric Roll-Call (Resemblyzer)</span>
                  <span class="text-emerald-400 font-medium">Embedding Verified</span>
                </div>
                <div class="flex items-center gap-1 h-6">
                  {[40, 75, 30, 90, 60, 45, 80, 100, 70, 50, 85, 40, 65, 30].map((h) => (
                    <span class="flex-1 rounded-full bg-brand-accent/70 transition-all duration-300 group-hover:bg-brand-accent" style={`height: ${h}%`}></span>
                  ))}
                </div>
              </div>
            </div>

            <div class="mt-3 flex items-center justify-between text-[0.65rem] text-brand-light/60">
              <span>Teacher Dashboard: Active</span>
              <span class="text-brand-light/40">Supabase PostgreSQL Sync</span>
            </div>
          </a>

          <!-- Text details -->
          <div class="flex flex-col gap-5">
            <div class="flex items-center gap-3">
              <span class="font-heading text-2xl font-bold text-brand-accent">02.</span>
              <p class="section-label text-brand-dark/60">AI-Powered Attendance System</p>
            </div>

            <h3 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-bold leading-tight text-brand-dark group-hover:text-brand-accent transition-colors">
              SnapClass
            </h3>

            <p class="text-sm sm:text-base leading-relaxed text-brand-dark/75">
              Designed and built an AI-powered attendance platform using computer vision to recognize students from a class photo, together with voice biometrics for sequential roll-call verification. Implemented QR-based course enrollment and a real-time teacher dashboard.
            </p>

            <!-- Tech tags -->
            <div class="flex flex-wrap gap-2 pt-1" aria-label="Technologies">
              {['Python', 'Computer Vision', 'FaceRecognition', 'Dlib', 'Resemblyzer', 'Librosa', 'Streamlit', 'Flask', 'Supabase'].map((tech) => (
                <span class="tech-tag">{tech}</span>
              ))}
            </div>

            <!-- Actions -->
            <div class="flex flex-wrap items-center gap-3 pt-3 border-t border-brand-dark/10">
              <a
                href="https://snapclass-landing-hazel.vercel.app/"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary group/btn text-xs h-10 px-6 inline-flex items-center gap-2"
              >
                <span>Live Demo</span>
                <span aria-hidden="true" class="transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5">&nearr;</span>
              </a>
              <span class="text-xs text-brand-dark/50">Verified Live Application</span>
            </div>
          </div>
        </div>
      </article>

      <!-- Project 03: Smart Customer Segmentation System -->
      <article
        class="project-card group rounded-2xl md:rounded-3xl border border-brand-dark/10 bg-surface p-6 sm:p-8 lg:p-12 transition-all duration-500 hover:border-brand-accent/40 hover:shadow-xl"
        data-reveal data-delay="3"
      >
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-12">
          <!-- Text details -->
          <div class="flex flex-col gap-5 order-2 lg:order-1">
            <div class="flex items-center gap-3">
              <span class="font-heading text-2xl font-bold text-brand-accent">03.</span>
              <p class="section-label text-brand-dark/60">Unsupervised Machine Learning</p>
            </div>

            <h3 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-bold leading-tight text-brand-dark group-hover:text-brand-accent transition-colors">
              Smart Customer Segmentation System for E-Commerce
            </h3>

            <p class="text-sm sm:text-base leading-relaxed text-brand-dark/75">
              Built and deployed an interactive tool that segments e-commerce customers into actionable groups using RFM feature engineering and K-Means clustering, validated with the Elbow Method and Silhouette Score. Applied PCA while retaining over 90% of variance to improve cluster interpretability in a live, user-facing Streamlit application.
            </p>

            <!-- Tech tags -->
            <div class="flex flex-wrap gap-2 pt-1" aria-label="Technologies">
              {['Python', 'Pandas', 'NumPy', 'Scikit-learn', 'K-Means Clustering', 'RFM Analysis', 'PCA', 'Streamlit'].map((tech) => (
                <span class="tech-tag">{tech}</span>
              ))}
            </div>

            <!-- Actions -->
            <div class="flex flex-wrap items-center gap-3 pt-3 border-t border-brand-dark/10">
              <a
                href="https://smartcart-segmentation-zuxhyiwtapkld2vhnutyue.streamlit.app/"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary group/btn text-xs h-10 px-6 inline-flex items-center gap-2"
              >
                <span>Live Demo</span>
                <span aria-hidden="true" class="transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5">&nearr;</span>
              </a>
              <span class="text-xs text-brand-dark/50">Verified Live Streamlit App</span>
            </div>
          </div>

          <!-- UI Showcase Mockup -->
          <a
            href="https://smartcart-segmentation-zuxhyiwtapkld2vhnutyue.streamlit.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="order-1 lg:order-2 block overflow-hidden rounded-xl border border-brand-dark/15 bg-[#1a1a18] p-5 text-brand-light shadow-lg transition-transform duration-700 ease-out group-hover:scale-[1.02]"
            data-cursor-target
            data-cursor-label="Live Demo ↗"
          >
            <div class="flex items-center justify-between border-b border-brand-light/10 pb-3">
              <div class="flex items-center gap-2">
                <span class="font-mono text-[0.7rem] text-brand-light/60">RFM Analysis &bull; PCA Cluster Projection</span>
              </div>
              <span class="rounded bg-brand-accent/20 px-2 py-0.5 text-[0.65rem] font-medium text-brand-accent">PCA Variance &gt; 90%</span>
            </div>

            <!-- Scatter plot projection representation -->
            <div class="mt-4 rounded-lg border border-brand-light/10 bg-brand-light/5 p-4">
              <div class="flex items-center justify-between text-[0.65rem] text-brand-light/50 mb-3">
                <span>PCA Component 1 vs PCA Component 2</span>
                <span>Silhouette Validated</span>
              </div>

              <!-- SVG Visual Graph -->
              <svg viewBox="0 0 260 120" class="w-full h-28" fill="none" aria-hidden="true">
                <!-- Axes -->
                <line x1="20" y1="100" x2="250" y2="100" stroke="rgba(245,240,232,0.15)" stroke-width="1"/>
                <line x1="20" y1="10" x2="20" y2="100" stroke="rgba(245,240,232,0.15)" stroke-width="1"/>

                <!-- Cluster 1 (Champions) -->
                <circle cx="180" cy="30" r="4" fill="#d4a853"/>
                <circle cx="195" cy="25" r="3.5" fill="#d4a853"/>
                <circle cx="170" cy="40" r="4.5" fill="#d4a853"/>
                <circle cx="210" cy="35" r="3" fill="#d4a853"/>
                <circle cx="185" cy="48" r="4" fill="#d4a853"/>

                <!-- Cluster 2 (Regulars) -->
                <circle cx="90" cy="65" r="4" fill="#38bdf8"/>
                <circle cx="110" cy="60" r="3.5" fill="#38bdf8"/>
                <circle cx="80" cy="75" r="4.5" fill="#38bdf8"/>
                <circle cx="105" cy="80" r="3" fill="#38bdf8"/>
                <circle cx="95" cy="50" r="4" fill="#38bdf8"/>

                <!-- Cluster 3 (At Risk) -->
                <circle cx="45" cy="85" r="3.5" fill="#f87171"/>
                <circle cx="35" cy="90" r="4" fill="#f87171"/>
                <circle cx="55" cy="80" r="3" fill="#f87171"/>
                <circle cx="60" cy="92" r="4" fill="#f87171"/>
              </svg>

              <!-- Cluster Legend -->
              <div class="mt-3 grid grid-cols-3 gap-2 border-t border-brand-light/10 pt-2.5 text-[0.62rem]">
                <div class="flex items-center gap-1.5">
                  <span class="h-2 w-2 rounded-full bg-brand-accent"></span>
                  <span class="text-brand-light/75">High-Value</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="h-2 w-2 rounded-full bg-sky-400"></span>
                  <span class="text-brand-light/75">Regulars</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="h-2 w-2 rounded-full bg-rose-400"></span>
                  <span class="text-brand-light/75">At Risk</span>
                </div>
              </div>
            </div>

            <div class="mt-3 flex items-center justify-between text-[0.65rem] text-brand-light/60">
              <span>Optimal K: Elbow Method</span>
              <span class="text-emerald-400 font-medium">Interactive Streamlit Dashboard</span>
            </div>
          </a>
        </div>
      </article>

    </div>
  </div>
</section>
