---
import { personal } from '../data/portfolio';
---

<section id="contact" class="relative overflow-hidden bg-brand-dark py-24 md:py-32 lg:py-40">
  <!-- Background texture -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.04]" aria-hidden="true">
    <svg width="100%" height="100%"><filter id="noise2"><feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/></filter><rect width="100%" height="100%" filter="url(#noise2)"/></svg>
  </div>

  <!-- Accent ambient blobs -->
  <div class="pointer-events-none absolute -left-40 -top-40 h-96 w-96 rounded-full bg-brand-accent/10 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-40 -right-40 h-80 w-80 rounded-full bg-brand-accent/8 blur-3xl" aria-hidden="true"></div>

  <div class="ui-container relative z-10">
    <div class="mx-auto max-w-3xl text-center">
      <!-- Label -->
      <p class="section-label mb-5 text-brand-accent" data-reveal>Get in touch</p>

      <!-- Heading with staggered line reveals -->
      <h2
        class="font-heading text-[clamp(2.5rem,6vw,4.5rem)] font-bold leading-[0.97] tracking-[-0.04em] text-brand-light"
        data-reveal data-delay="1"
      >
        <span class="reveal-line-wrap">
          <span class="reveal-line-inner" data-delay="1">Let's build something</span>
        </span>
        <br />
        <span class="reveal-line-wrap">
          <span class="reveal-line-inner text-brand-accent italic font-normal" data-delay="2">meaningful.</span>
        </span>
      </h2>

      <!-- Body -->
      <p
        class="mx-auto mt-7 max-w-xl text-[clamp(0.95rem,1.4vw,1.1rem)] leading-relaxed text-brand-light/70"
        data-reveal data-delay="3"
      >
        I'm interested in data science, machine learning, and building practical applications.
        I'm always keen to learn, experiment, and connect with people who enjoy solving technical problems.
      </p>

      <!-- Primary Email CTA with arrow animation -->
      <div class="mt-10 flex flex-col items-center gap-4" data-reveal data-delay="4">
        <a
          href={`mailto:${personal.email}`}
          class="group inline-flex items-center gap-3 rounded-full bg-brand-accent px-8 py-4 text-base font-semibold text-brand-dark transition-all duration-300 hover:bg-brand-light hover:text-brand-dark hover:shadow-xl hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <span>{personal.email}</span>
          <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
        </a>
      </div>

      <!-- Divider -->
      <div class="my-10 flex items-center gap-4" data-reveal data-delay="5">
        <span class="flex-1 border-t border-brand-light/10"></span>
        <span class="text-xs uppercase tracking-[0.2em] text-brand-light/40">or find me on</span>
        <span class="flex-1 border-t border-brand-light/10"></span>
      </div>

      <!-- Contact details grid with hover lift -->
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-3" data-reveal data-delay="6">
        <a
          href={personal.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col items-center gap-2 rounded-2xl border border-brand-light/10 bg-brand-light/[0.02] p-6 text-center transition-all duration-300 hover:border-brand-accent/50 hover:bg-brand-light/10 hover:-translate-y-1 hover:shadow-lg"
          aria-label="LinkedIn profile"
        >
          <div class="flex h-11 w-11 items-center justify-center rounded-full border border-brand-light/20 text-brand-light/60 transition-colors duration-300 group-hover:border-brand-accent group-hover:bg-brand-accent group-hover:text-brand-dark">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-light/50">LinkedIn</p>
            <p class="mt-1 text-xs text-brand-light/75">subham-acharya</p>
          </div>
        </a>

        <a
          href={personal.github}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col items-center gap-2 rounded-2xl border border-brand-light/10 bg-brand-light/[0.02] p-6 text-center transition-all duration-300 hover:border-brand-accent/50 hover:bg-brand-light/10 hover:-translate-y-1 hover:shadow-lg"
          aria-label="GitHub profile"
        >
          <div class="flex h-11 w-11 items-center justify-center rounded-full border border-brand-light/20 text-brand-light/60 transition-colors duration-300 group-hover:border-brand-accent group-hover:bg-brand-accent group-hover:text-brand-dark">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-light/50">GitHub</p>
            <p class="mt-1 text-xs text-brand-light/75">subham240</p>
          </div>
        </a>

        <a
          href={`tel:${personal.phone.replace(/\s/g,'')}`}
          class="group flex flex-col items-center gap-2 rounded-2xl border border-brand-light/10 bg-brand-light/[0.02] p-6 text-center transition-all duration-300 hover:border-brand-accent/50 hover:bg-brand-light/10 hover:-translate-y-1 hover:shadow-lg"
          aria-label={`Call ${personal.phone}`}
        >
          <div class="flex h-11 w-11 items-center justify-center rounded-full border border-brand-light/20 text-brand-light/60 transition-colors duration-300 group-hover:border-brand-accent group-hover:bg-brand-accent group-hover:text-brand-dark">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.44 2 2 0 0 1 3.59 1.27h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.4a16 16 0 0 0 6 6l.4-.89a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21 15.97v.95z"/></svg>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-light/50">Phone</p>
            <p class="mt-1 text-xs text-brand-light/75">{personal.phone}</p>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>
