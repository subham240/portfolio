---
import { personal } from '../data/portfolio';

const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
  { href: '#education', label: 'Education' },
  { href: '#contact', label: 'Contact' },
];
---

<!-- Mobile nav drawer -->
<div id="nav-drawer" class="nav-drawer" role="presentation">
  <div class="nav-drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>
  <aside class="nav-drawer-panel" role="dialog" aria-modal="true" aria-label="Navigation menu">
    <div class="flex items-center justify-between">
      <a href="/" class="font-heading text-base font-bold tracking-[0.18em] text-brand-dark uppercase" aria-label={personal.name}>
        Subham Acharya
      </a>
      <button id="drawer-close" class="flex h-9 w-9 items-center justify-center rounded-full border border-brand-dark/15 text-brand-dark transition-colors hover:bg-brand-dark hover:text-brand-light" aria-label="Close menu">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <nav aria-label="Mobile navigation">
      <ul class="flex flex-col gap-1">
        {navLinks.map((link, idx) => (
          <li class="drawer-link-item" style={`--stagger: ${idx}`}>
            <a href={link.href} class="drawer-link block rounded-lg px-3 py-3 text-xl font-heading font-semibold text-brand-dark transition-colors hover:text-brand-accent" data-drawer-close>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-auto flex flex-col gap-3">
      <a
        href="/documents/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-outline text-center text-sm py-2.5 flex items-center justify-center gap-2"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span>View Resume (PDF)</span>
      </a>
      <a href={`mailto:${personal.email}`} class="btn-primary text-center text-sm py-2.5">{personal.email}</a>
      <div class="flex gap-3">
        <a href={personal.github} target="_blank" rel="noopener noreferrer" class="flex-1 rounded-lg border border-brand-dark/15 py-2 text-center text-sm font-medium text-brand-dark/70 transition-colors hover:border-brand-dark hover:text-brand-dark">GitHub</a>
        <a href={personal.linkedin} target="_blank" rel="noopener noreferrer" class="flex-1 rounded-lg border border-brand-dark/15 py-2 text-center text-sm font-medium text-brand-dark/70 transition-colors hover:border-brand-dark hover:text-brand-dark">LinkedIn</a>
      </div>
    </div>
  </aside>
</div>

<!-- Fixed header (appears on scroll) -->
<header
  id="site-header"
  class="fixed left-0 top-0 z-[100] w-full border-b border-transparent bg-transparent transition-all duration-300"
  data-header
>
  <div class="ui-container">
    <div class="flex items-center justify-between gap-4 py-4">
      <!-- Logo -->
      <a href="/" class="relative z-10 flex items-center gap-2" aria-label={personal.name}>
        <span class="font-heading text-sm sm:text-base font-bold tracking-[0.18em] text-brand-dark uppercase">Subham Acharya</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden items-center gap-6 lg:flex" aria-label="Main navigation">
        {navLinks.map((link) => (
          <a href={link.href} class="nav-link text-sm font-medium">
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Desktop CTA + mobile hamburger -->
      <div class="flex items-center gap-2.5">
        <a
          href="/documents/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline hidden sm:inline-flex text-xs h-9 px-4 py-0 items-center gap-1.5"
          title="Open Resume PDF in new tab"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span>Resume</span>
        </a>
        <a href="#contact" class="btn-primary hidden sm:inline-flex text-sm h-9 px-5 py-0">
          Get in Touch
        </a>
        <button id="nav-open" class="flex h-9 w-9 flex-col items-center justify-center gap-[5px] rounded-full border border-brand-dark/15 lg:hidden" aria-controls="nav-drawer" aria-expanded="false" aria-label="Open navigation menu">
          <span class="h-[1.5px] w-5 bg-brand-dark transition-all"></span>
          <span class="h-[1.5px] w-5 bg-brand-dark transition-all"></span>
          <span class="h-[1.5px] w-4 bg-brand-dark transition-all"></span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Spacer so content doesn't go under fixed header -->
<div class="h-[5rem]" aria-hidden="true"></div>

<script>
  // Header scroll state
  const header = document.querySelector('[data-header]') as HTMLElement;
  const updateHeader = () => {
    if (window.scrollY > 60) {
      header.classList.add('scrolled');
      header.style.borderBottomColor = 'rgba(26,26,24,0.08)';
      header.style.backgroundColor = 'rgba(250,247,242,0.95)';
      header.style.backdropFilter = 'blur(12px)';
    } else {
      header.style.borderBottomColor = 'transparent';
      header.style.backgroundColor = 'transparent';
      header.style.backdropFilter = 'none';
    }
  };
  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();

  // Mobile drawer
  const drawer = document.getElementById('nav-drawer')!;
  const openBtn = document.getElementById('nav-open')!;
  const closeBtn = document.getElementById('drawer-close')!;
  const backdrop = document.getElementById('drawer-backdrop')!;

  const openDrawer = () => {
    drawer.classList.add('open');
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };
  const closeDrawer = () => {
    drawer.classList.remove('open');
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };

  openBtn.addEventListener('click', openDrawer);
  closeBtn.addEventListener('click', closeDrawer);
  backdrop.addEventListener('click', closeDrawer);

  // Close on nav link click
  drawer.querySelectorAll('[data-drawer-close]').forEach((el) =>
    el.addEventListener('click', closeDrawer)
  );

  // Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer.classList.contains('open')) closeDrawer();
  });
</script>
