---
import { focusAreas } from '../data/portfolio';

const icons = [
  // 01 Data Science: Database / Analytics
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"/></svg>`,
  // 02 Machine Learning: Network / Nodes
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>`,
  // 03 AI Applications: Sparkles / Brain
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>`,
  // 04 Software Development: Layout / Terminal
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>`,
];
---

<section id="focus" class="ui-section bg-[#faf7f2] relative z-[1]">
  <div class="ui-container">
    <div class="mb-14 grid grid-cols-1 gap-6 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <p class="section-label mb-3" data-reveal>Focus & Direction</p>
        <h2 class="section-heading" data-reveal data-delay="1">Areas of technical interest</h2>
      </div>
      <p class="max-w-xs text-sm leading-relaxed text-brand-dark/70 md:text-right" data-reveal data-delay="2">
        Core engineering domains I actively build within, experiment with, and seek to advance.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {focusAreas.map((area, i) => (
        <article
          class="group relative flex flex-col justify-between gap-6 overflow-hidden rounded-2xl border border-brand-dark/10 bg-surface p-7 transition-all duration-300 hover:border-brand-accent/50 hover:bg-amber-50/70 hover:-translate-y-1 hover:shadow-lg cursor-default"
          data-reveal
          data-delay={String((i % 4) + 1)}
        >
          <!-- Top row: Number & Icon -->
          <div class="flex items-center justify-between">
            <span class="font-heading text-3xl font-bold text-brand-accent select-none">
              {area.number}.
            </span>
            <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-brand-dark/10 bg-[#faf7f2] text-brand-dark/70 transition-all duration-300 group-hover:border-brand-accent group-hover:bg-brand-accent group-hover:text-brand-dark">
              <Fragment set:html={icons[i % icons.length]} />
            </div>
          </div>

          <!-- Content -->
          <div class="flex flex-col gap-2.5">
            <h3 class="font-heading text-lg font-bold leading-snug text-brand-dark transition-colors duration-300 group-hover:text-brand-accent">
              {area.title}
            </h3>
            <p class="text-xs sm:text-sm leading-relaxed text-brand-dark/70">
              {area.description}
            </p>
          </div>

          <!-- Nova signature sliding arrow micro-interaction -->
          <div class="pt-2 border-t border-brand-dark/10 flex items-center justify-between">
            <span class="text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-brand-dark/45 group-hover:text-brand-dark transition-colors">
              Explore
            </span>
            <span class="relative flex h-7 w-7 items-center justify-center overflow-hidden rounded-full border border-brand-dark/15 text-xs text-brand-dark transition-all duration-300 group-hover:border-brand-accent group-hover:bg-brand-accent" aria-hidden="true">
              <span class="absolute inset-0 flex items-center justify-center transition-transform duration-300 ease-out group-hover:translate-x-[140%] group-hover:-translate-y-[140%]">
                &nearr;
              </span>
              <span class="absolute inset-0 flex items-center justify-center -translate-x-[140%] translate-y-[140%] transition-transform duration-300 ease-out group-hover:translate-x-0 group-hover:translate-y-0">
                &nearr;
              </span>
            </span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
