
---
import { personal } from '../data/portfolio';
---

<section id="hero" class="relative overflow-hidden bg-[#faf7f2] pt-4 md:pt-6">
  <!-- Subtle background noise texture -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.03]" aria-hidden="true">
    <svg width="100%" height="100%">
      <filter id="hero-noise">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="4" stitchTiles="stitch"/>
        <feColorMatrix type="saturate" values="0"/>
      </filter>
      <rect width="100%" height="100%" filter="url(#hero-noise)"/>
    </svg>
  </div>

  <div class="ui-container relative z-10 w-full max-w-none px-4 sm:px-6 lg:px-8">
    <div class="grid min-h-[calc(100vh-10rem)] grid-cols-1 items-center gap-10 md:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-14">

      <!-- Left: Editorial text content -->
      <div class="flex flex-col justify-center py-8 lg:py-12">
        <div class="flex flex-col gap-6 lg:gap-8">

          <div class="flex flex-col gap-2" data-reveal data-delay="1">
            <div class="flex items-center gap-2">
              <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
              <span class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-dark/60">
                Available for internships & projects
              </span>
            </div>
            <p class="section-label">
              {personal.name} &bull; {personal.role}
            </p>
          </div>

          <!-- Main heading -->
          <h1 class="font-heading text-[clamp(2.75rem,6.5vw,5rem)] font-bold leading-[0.98] tracking-[-0.04em] text-brand-dark">
            <span class="reveal-line-wrap">
              <span class="reveal-line-inner" data-delay="1">Turning data into</span>
            </span>
            <br />
            <span class="reveal-line-wrap">
              <span class="reveal-line-inner text-brand-accent italic font-normal" data-delay="2">intelligent</span>
            </span>
            <br />
            <span class="reveal-line-wrap">
              <span class="reveal-line-inner" data-delay="3">applications.</span>
            </span>
          </h1>

          <!-- Intro -->
          <p class="max-w-[36rem] text-[clamp(1rem,1.35vw,1.15rem)] leading-relaxed text-brand-dark/75" data-reveal data-delay="3">
            {personal.intro}
          </p>

          <!-- CTA buttons -->
          <div class="flex flex-wrap items-center gap-3.5 pt-2" data-reveal data-delay="4">
            <a href="#projects" class="btn-primary text-sm sm:text-base h-12 px-7">
              <span>Explore Projects</span>
              <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-y-0.5">&darr;</span>
            </a>

            <a href={personal.resumeUrl} target="_blank" rel="noopener noreferrer"
              class="btn-outline text-sm sm:text-base h-12 px-6 inline-flex items-center gap-2"
              title="Open Resume PDF in new tab">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              <span>Resume (PDF)</span>
            </a>

            <a href="#contact" class="btn-outline text-sm sm:text-base h-12 px-6">
              <span>Get in Touch</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>

          <!-- Social links -->
          <div class="flex flex-wrap items-center gap-4 pt-2 border-t border-brand-dark/10" data-reveal data-delay="5">
            <a href={personal.github} target="_blank" rel="noopener noreferrer"
              class="group flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.14em] text-brand-dark/60 transition-colors hover:text-brand-dark"
              aria-label="GitHub profile">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              <span>GitHub</span>
            </a>

            <span class="h-3 w-px bg-brand-dark/20" aria-hidden="true"></span>

            <a href={personal.linkedin} target="_blank" rel="noopener noreferrer"
              class="group flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.14em] text-brand-dark/60 transition-colors hover:text-brand-dark"
              aria-label="LinkedIn profile">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              <span>LinkedIn</span>
            </a>

            <span class="h-3 w-px bg-brand-dark/20" aria-hidden="true"></span>

            <span class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-dark/45">
              {personal.location}
            </span>
          </div>
        </div>
      </div>

      <!-- Right: Profile portrait -->
      <div class="relative flex items-center justify-center py-6 md:py-0">

        <div class="pointer-events-none absolute -inset-4 rounded-3xl bg-brand-accent/10 blur-2xl" aria-hidden="true"></div>

        <div class="relative w-full max-w-[28rem] overflow-hidden rounded-2xl md:rounded-[2rem] border border-brand-dark/10 bg-surface shadow-xl hero-image-mask">
          <figure class="relative aspect-[4/5] w-full overflow-hidden">

            <!-- UPDATED IMAGE PATH FOR VERCEL -->
            <img
              src="/images/subham.jpg"
              alt="Subham Acharya — AI & ML Engineer"
              class="h-full w-full object-cover object-top hero-image-zoom transition-transform duration-[1400ms] ease-out hover:scale-[1.03]"
              width="600"
              height="750"
              loading="eager"
              decoding="async"
            />

            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-brand-dark via-brand-dark/80 to-transparent p-6 text-brand-light">
              <p class="font-heading text-xl md:text-2xl font-bold tracking-tight text-brand-light">
                {personal.name}
              </p>
              <p class="mt-1 text-xs font-semibold uppercase tracking-[0.16em] text-brand-accent">
                {personal.role}
              </p>
              <p class="mt-2 text-xs text-brand-light/75">
                Computer Science Undergraduate &bull; B.Tech 2023–2027
              </p>
            </div>

          </figure>
        </div>
      </div>
    </div>

    <!-- Stats band -->
    <div class="mt-12 rounded-t-2xl md:rounded-t-3xl bg-brand-dark px-6 py-8 md:py-10 text-brand-light"
      data-reveal data-delay="6" aria-label="Key highlights">

      <div class="grid grid-cols-2 gap-6 md:grid-cols-4 md:gap-8 divide-y divide-brand-light/10 md:divide-y-0 md:divide-x md:divide-brand-light/10">

        <div class="flex flex-col items-center gap-1.5 text-center pt-4 first:pt-0 md:pt-0 md:px-4">
          <strong class="font-heading text-3xl md:text-4xl font-bold text-brand-accent">3</strong>
          <span class="text-xs font-medium uppercase tracking-[0.14em] text-brand-light/70">Featured ML Projects</span>
        </div>

        <div class="flex flex-col items-center gap-1.5 text-center pt-4 md:pt-0 md:px-4">
          <strong class="font-heading text-3xl md:text-4xl font-bold text-brand-accent">8.48</strong>
          <span class="text-xs font-medium uppercase tracking-[0.14em] text-brand-light/70">B.Tech CGPA / 10</span>
        </div>

        <div class="flex flex-col items-center gap-1.5 text-center pt-4 md:pt-0 md:px-4">
          <strong class="font-heading text-3xl md:text-4xl font-bold text-brand-accent">2027</strong>
          <span class="text-xs font-medium uppercase tracking-[0.14em] text-brand-light/70">Graduation Year</span>
        </div>

        <div class="flex flex-col items-center gap-1.5 text-center pt-4 md:pt-0 md:px-4">
          <strong class="font-heading text-3xl md:text-4xl font-bold text-brand-accent">End-to-End</strong>
          <span class="text-xs font-medium uppercase tracking-[0.14em] text-brand-light/70">EDA to Deployment</span>
        </div>

      </div>
    </div>
  </div>
</section>
