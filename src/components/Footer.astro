---
import { personal } from '../data/portfolio';

const year = new Date().getFullYear();

const footerLinks = [
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
  { href: '#education', label: 'Education' },
  { href: '#certifications', label: 'Certifications' },
  { href: '#contact', label: 'Contact' },
];
---

<footer class="border-t border-brand-dark/10 bg-brand-dark text-brand-light">
  <div class="ui-container py-16 md:py-20">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-[1fr_auto_auto]">
      <!-- Brand -->
      <div class="flex flex-col gap-4">
        <a href="/" class="font-heading text-xl font-bold tracking-[0.16em] uppercase text-brand-light" aria-label={personal.name}>
          Subham Acharya
        </a>
        <p class="max-w-xs text-sm text-brand-light/60 leading-relaxed">
          {personal.name}<br />
          {personal.role}
        </p>
        <div class="flex gap-3 mt-2">
          <a
            href={personal.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-brand-light/15 text-brand-light/60 transition-colors hover:border-brand-accent hover:text-brand-accent"
            aria-label="GitHub profile"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          </a>
          <a
            href={personal.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-brand-light/15 text-brand-light/60 transition-colors hover:border-brand-accent hover:text-brand-accent"
            aria-label="LinkedIn profile"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a
            href={`mailto:${personal.email}`}
            class="flex h-9 w-9 items-center justify-center rounded-full border border-brand-light/15 text-brand-light/60 transition-colors hover:border-brand-accent hover:text-brand-accent"
            aria-label="Send email"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </a>
        </div>
      </div>

      <!-- Nav links -->
      <div class="flex flex-col gap-3">
        <p class="section-label text-brand-light/40">Navigation</p>
        <nav aria-label="Footer navigation">
          <ul class="flex flex-col gap-2">
            {footerLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-brand-light/60 transition-colors hover:text-brand-accent">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Contact -->
      <div class="flex flex-col gap-3">
        <p class="section-label text-brand-light/40">Contact</p>
        <div class="flex flex-col gap-2 text-sm text-brand-light/60">
          <a href={`mailto:${personal.email}`} class="transition-colors hover:text-brand-accent break-all">
            {personal.email}
          </a>
          <a href={`tel:${personal.phone.replace(/\s/g,'')}`} class="transition-colors hover:text-brand-accent">
            {personal.phone}
          </a>
          <span class="text-brand-light/40">{personal.location}</span>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-brand-light/10 pt-8 sm:flex-row sm:items-center">
      <p class="text-xs text-brand-light/40">
        &copy; {year} {personal.name}. All rights reserved.
      </p>
      <a href="#main-content" class="text-xs text-brand-light/40 transition-colors hover:text-brand-accent">
        Back to top ↑
      </a>
    </div>
  </div>
</footer>
